{
  "platform": {
    "apiRuntime": "node:20"
  },
  "routes": [
    {
      "route": "/api/*",
      "methods": [
        "PUT",
        "DELETE",
        "PATCH"
      ],
      "statusCode": 405
    },
    {
      "route": "/api/readiness/assessment",
      "allowedRoles": [
        "authenticated"
      ]
    },
    {
      "route": "/login",
      "redirect": "/.auth/login/aad?post_login_redirect_uri=/portal/"
    },
    {
      "route": "/logout",
      "redirect": "/.auth/logout?post_logout_redirect_uri=/"
    },
    {
      "route": "/.auth/login/github",
      "statusCode": 404
    },
    {
      "route": "/.auth/login/twitter",
      "statusCode": 404
    },
    {
      "route": "/api/comments/admin",
      "allowedRoles": [
        "authenticated"
      ]
    },
    {
      "route": "/api/ratings/admin",
      "allowedRoles": [
        "authenticated"
      ]
    },
    {
      "route": "/api/admin/*",
      "allowedRoles": [
        "authenticated"
      ]
    },
    {
      "route": "/portal/admin*",
      "redirect": "/admin-portal/",
      "statusCode": 301
    },
    {
      "route": "/admin-portal/*",
      "allowedRoles": [
        "authenticated"
      ],
      "headers": {
        "Cache-Control": "no-store",
        "X-Robots-Tag": "noindex"
      }
    },
    {
      "route": "/admin-portal*",
      "allowedRoles": [
        "authenticated"
      ],
      "headers": {
        "Cache-Control": "no-store",
        "X-Robots-Tag": "noindex"
      }
    },
    {
      "route": "/portal/join/*",
      "headers": {
        "Cache-Control": "no-store",
        "X-Robots-Tag": "noindex"
      }
    },
    {
      "route": "/portal/join*",
      "headers": {
        "Cache-Control": "no-store",
        "X-Robots-Tag": "noindex"
      }
    },
    {
      "route": "/portal/*",
      "allowedRoles": [
        "authenticated"
      ],
      "headers": {
        "Cache-Control": "no-store",
        "X-Robots-Tag": "noindex"
      }
    },
    {
      "route": "/portal*",
      "allowedRoles": [
        "authenticated"
      ],
      "headers": {
        "Cache-Control": "no-store",
        "X-Robots-Tag": "noindex"
      }
    }
  ],
  "responseOverrides": {
    "401": {
      "redirect": "/.auth/login/aad?post_login_redirect_uri=.referrer",
      "statusCode": 302
    },
    "403": {
      "rewrite": "/access-denied.html",
      "statusCode": 403
    },
    "404": {
      "rewrite": "/404.html",
      "statusCode": 404
    }
  }
}
